# Shared Docker Compose environment. Copy this file to .env and fill in secrets.

# MySQL
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=mbti_db

# Backend container -> database container
DATABASE_URL=mysql://root:change-me@db:3306/mbti_db
PORT=5175

# Backend -> frontend browser origin
FRONTEND_URL=http://localhost:3000

# Backend -> Python service container
FASTAPI_URL=http://backend_python:8000

# Frontend server container -> backend container
BACKEND_URL=http://mbti_express:5175

# Browser -> backend published on the host
NEXT_PUBLIC_BACKEND_URL=http://localhost:5175

# Google authentication
GOOGLE_CLIENT_ID=change-me
NEXT_PUBLIC_GOOGLE_CLIENT_ID=change-me
JWT_SECRET=change-me

# Python service
GROQ_API_KEY=change-me
